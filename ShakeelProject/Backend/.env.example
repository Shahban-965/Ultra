NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =====================================================================
# SHAKEELPROJECT — XAMPP MySQL (start Apache + MySQL in XAMPP first)
# The backend auto-imports database/shakeelproject.sql on first start.
# =====================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shakeelproject_db

VAULT_STORAGE_DIR=./storage/vault

# =====================================================================
# SECRETS — these are DEV-ONLY generated values so the app runs
# immediately. For PRODUCTION generate your own (openssl rand -hex 32)
# and set NODE_ENV=production (the app REFUSES to boot without them).
# =====================================================================
JWT_ADMIN_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_USER_SECRET=CHANGE_ME_openssl_rand_hex_32
PADLOCK_TICKET_SECRET=CHANGE_ME_openssl_rand_hex_32
AES_256_VAULT_KEY=CHANGE_ME_openssl_rand_hex_32

# =====================================================================
# MASTER ADMIN IDENTITY (5-step padlock)
# Gate-1 PIN + Gate-2 email/password below are used to seed the DB.
# Change ALL of them before you share the site!
# =====================================================================
ADMIN_MASTER_PIN=YOUR_6_DIGIT_PIN
ADMIN_MASTER_EMAIL=your-email@example.com
ADMIN_MASTER_PASSWORD=YOUR_STRONG_PASSWORD

# TOTP secret (base32) — scan it in Google Authenticator / Aegis.
# In development the fallback code 123456 is also accepted; in
# production the fallback is DISABLED automatically.
ADMIN_TOTP_SECRET=CHANGE_ME_base32_totp_secret
ADMIN_ALLOW_DEV_TOTP_CODE=123456

# Optional: comma-separated IPs allowed to reach admin APIs (empty = all)
ADMIN_IP_ALLOWLIST=
ADMIN_MAX_FAILED_ATTEMPTS=3
ADMIN_BAN_DURATION_MINUTES=30
